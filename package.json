{
  "name": "done-and-dusted",
  "version": "1.8.0",
  "private": true,
  "description": "Done & Dusted: plan it, do it, dust it. A task manager with Google Keep import, reminders, a RAG dashboard and week planning.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#E39A14' --iconBackgroundColorDark '#E39A14' --splashBackgroundColor '#EEF1F4' --splashBackgroundColorDark '#0E141A'",
    "android": "vite build && cap sync android && cap open android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dexie": "^4.4.7",
    "jszip": "^3.10.1",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "vite": "^8.3.7"
  }
}

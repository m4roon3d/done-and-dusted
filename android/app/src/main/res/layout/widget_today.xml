<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/ddw_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="@color/ddw_ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open the app once to fill this in" android:textColor="@color/ddw_muted" android:textSize="12sp"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/add" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Add a task">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@drawable/ddw_add"/>
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/tick0" android:layout_width="40dp" android:layout_height="44dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ddw_tick" android:contentDescription="Mark done"/>
            </FrameLayout>
            <TextView android:id="@+id/dot0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/title0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ddw_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/when0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ddw_muted" android:textSize="12sp" android:layout_marginStart="8dp" android:fontFamily="monospace"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/tick1" android:layout_width="40dp" android:layout_height="44dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ddw_tick" android:contentDescription="Mark done"/>
            </FrameLayout>
            <TextView android:id="@+id/dot1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ddw_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/when1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ddw_muted" android:textSize="12sp" android:layout_marginStart="8dp" android:fontFamily="monospace"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/tick2" android:layout_width="40dp" android:layout_height="44dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ddw_tick" android:contentDescription="Mark done"/>
            </FrameLayout>
            <TextView android:id="@+id/dot2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ddw_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/when2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ddw_muted" android:textSize="12sp" android:layout_marginStart="8dp" android:fontFamily="monospace"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/tick3" android:layout_width="40dp" android:layout_height="44dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ddw_tick" android:contentDescription="Mark done"/>
            </FrameLayout>
            <TextView android:id="@+id/dot3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ddw_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/when3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ddw_muted" android:textSize="12sp" android:layout_marginStart="8dp" android:fontFamily="monospace"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/tick4" android:layout_width="40dp" android:layout_height="44dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ddw_tick" android:contentDescription="Mark done"/>
            </FrameLayout>
            <TextView android:id="@+id/dot4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textSize="9sp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/title4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ddw_ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/when4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ddw_muted" android:textSize="12sp" android:layout_marginStart="8dp" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="10dp" android:text="Nothing due today 🎉" android:textColor="@color/ddw_muted" android:textSize="13sp" android:visibility="gone"/>
    <TextView android:id="@+id/more" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="46dp" android:textColor="@color/ddw_muted" android:textSize="12sp" android:visibility="gone"/>
</LinearLayout>
